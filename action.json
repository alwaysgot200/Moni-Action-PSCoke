{
  "schema": "moni-action-v1",
  "id": "ps.browser-image-to-layer",
  "version": "1.3.2",
  "display": { "key": "action.name" },
  "type": "script",
  "engine": { "name": "lua", "version": "5.4" },
  "entry": "main.lua",
  "setup": {
    "entry": "setup.lua",
    "label": { "key": "setup.label" }
  },
  "compat": {
    "platforms": ["windows", "macos"],
    "arch": ["any"],
    "host": ">=0.1.0 <2.0.0",
    "features": ["bridge.browser>=1.0", "ps.jsx>=1"],
    "apps": [{ "id": "photoshop", "min": "22.0" }]
  },
  "applies_to": ["photoshop"],
  "permissions": [
    "bridge.call:browser",
    "net.fetch",
    "asset",
    "notify",
    "process.spawn:photoshop",
    "process.spawn:osascript"
  ],
  "programs": [
    {
      "id": "photoshop",
      "candidates": [
        "%ProgramFiles%/Adobe/Adobe Photoshop*/Photoshop.exe",
        "%ProgramFiles%/Adobe Photoshop*/Photoshop.exe",
        "%ProgramFiles(x86)%/Adobe/Adobe Photoshop*/Photoshop.exe",
        "%ProgramFiles(x86)%/Adobe Photoshop*/Photoshop.exe",
        "/Applications/Adobe Photoshop*/Adobe Photoshop*.app/Contents/MacOS/Adobe Photoshop*"
      ]
    },
    {
      "id": "osascript",
      "candidates": ["/usr/bin/osascript"]
    }
  ],
  "requires": {
    "bridges": [{ "name": "browser", "min": "1.0.0" }]
  },
  "options": {
    "launch_app": { "type": "boolean", "default": true, "label_key": "options.launch_app" },
    "mode": {
      "type": "enum",
      "values": ["picker", "selector", "context"],
      "default": "picker",
      "label_key": "options.mode"
    },
    "selector": { "type": "string", "default": "", "label_key": "options.selector" },
    "min_width": {
      "type": "integer",
      "default": 200,
      "label_key": "options.min_width"
    },
    "min_height": {
      "type": "integer",
      "default": 200,
      "label_key": "options.min_height"
    },
    "limit": {
      "type": "integer",
      "default": 50,
      "max": 200,
      "label_key": "options.limit"
    },
    "scroll": { "type": "boolean", "default": false, "label_key": "options.scroll" },
    "layout": {
      "type": "enum",
      "values": ["grid", "layers"],
      "default": "grid",
      "label_key": "options.layout"
    },
    "columns": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 8,
      "label_key": "options.columns"
    },
    "gap": {
      "type": "number",
      "default": 24,
      "min": 0,
      "max": 400,
      "label_key": "options.gap"
    },
    "fit": {
      "type": "enum",
      "values": ["contain", "original"],
      "default": "contain",
      "label_key": "options.fit"
    },
    "group": { "type": "boolean", "default": true, "label_key": "options.group" }
  },
  "ui": { "icon": "collect", "group": "photoshop" }
}
